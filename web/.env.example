# Next.js reads .env.local from this directory. Copy this file to web/.env.local.
#
# Only these two variables belong here. Both are browser-exposed by design and
# safe to ship: every request the anon key makes is filtered by the RLS policies
# in supabase/migrations/0006_rls.sql.
#
# SUPABASE_SERVICE_ROLE_KEY MUST NEVER APPEAR IN THIS DIRECTORY. It has
# BYPASSRLS and would hand every visitor the raw snapshot bodies, the per-source
# prices and the unblinded ground-truth pool.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
