# SIAP-PANGAN environment template.
# Copy to `.env` (repo root, gitignored) and fill in. Never commit `.env`.
#
# Split of responsibility:
#   - The Python engine writes to Postgres through DATABASE_URL (DDL + bulk
#     insert). That connection string is the only credential here that can
#     modify data, so it is the one worth protecting.
#   - The Next.js app only ever reads, through the anon key, constrained by RLS.
#
# There is deliberately NO service role key. Nothing in engine/src reads one —
# writes go through Postgres directly — and a key that bypasses every RLS policy
# in this project is not worth storing for a feature nobody uses. If a future
# feature genuinely needs the Supabase REST API as an admin, add it then, and
# never in web/ or in any NEXT_PUBLIC_* variable.

# --- engine (server-side only; also set as GitHub Actions secrets) ------------

# Supabase project REST endpoint, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# Direct Postgres connection string, used for migrations and bulk writes.
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Prefer the session pooler (port 5432) for DDL; append ?sslmode=require.
# postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# --- web (browser-exposed; safe to ship, protected by RLS) --------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- scraping conduct (see docs/architecture.md and config/sources.yaml) ------

# Contact address advertised in the User-Agent of every outbound request, so a
# portal operator can reach the team rather than silently blocking us.
SIAP_CONTACT_EMAIL=
